{
  "manifest_version": 2,
  "name": "VS Code Dark+ for GitHub",
  "version": "1.0.0",
  "description": "Apply VS Code Dark+ syntax highlighting colors to GitHub code blocks",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_title": "VS Code Dark+ for GitHub",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*",
        "*://gist.github.com/*"
      ],
      "css": ["styles/vscode-dark.css"],
      "js": ["content-scripts/inject.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vscode-github-syntax@example.com",
      "strict_min_version": "57.0"
    }
  }
}
